contacts = []

n = int(input("Enter number of contacts: "))

for i in range(n):
    name = input("Enter name: ")
    phone = input("Enter phone: ")

    contact = {
        "name": name,
        "phone": phone
    }

    contacts.append(contact)

print("\nContacts:")

for contact in contacts:
    print(contact["name"], "-", contact["phone"])
